소환!;

은교햄.변수("버블정렬", 임시 ㄽㅌ, ㅇ : 
    은교햄.반복(ㅇ-1,0, 0-1, 임시 ㅑ: 
        은교햄.반복(0, ㅑ, 1, 임시 ㅓ: 은교햄.만약(은교햄.인덱싱(ㄽㅌ,ㅓ) > 은교햄.인덱싱(ㄽㅌ, ㅓ+1),
            임시: 은교햄.변수(ㅅ드ㅔ, 은교햄.인덱싱(ㄽㅌ, ㅓ));
                은교햄.대체(ㄽㅌ, ㅓ, 은교햄.인덱싱(ㄽㅌ, ㅓ+1));
                은교햄.대체(ㄽㅌ, ㅓ+1, 은교햄.ㅅ드ㅔ)
                ,
            임시: 은교햄.엔터없이출력()
        ))
    )
);

은교햄.변수("리스트출력", 임시 ㅏㅏ, ㅜ :
    은교햄.반복(0,ㅜ,1, 
        임시 ㅏ : 은교햄.엔터없이출력(은교햄.인덱싱(ㅏㅏ, ㅏ)+", ")
    );
    은교햄.출력()
);

은교햄.변수(리스트, 은교햄.리스트(5,42,6,252,36,3,2));
은교햄.리스트출력(은교햄.리스트, 7);
은교햄.버블정렬(은교햄.리스트, 7);
은교햄.리스트출력(은교햄.리스트, 7);

특검 은교햄;